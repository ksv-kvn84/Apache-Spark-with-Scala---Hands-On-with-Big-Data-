#!/bin/bash
# production-block-kv.sh

echo "Enforcing strict dbutils.secrets blockade..."

# Target the sitecustomize.py file to run code automatically on Python startup
PYTHON_VERSION=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
SITE_PACKAGES="/databricks/python3/lib/python${PYTHON_VERSION}/site-packages"
mkdir -p "$SITE_PACKAGES"

cat << 'EOF' > "$SITE_PACKAGES/sitecustomize.py"
import builtins
import sys

# Define a malicious handler that blocks secret retrieval
def blocked_secrets_get(*args, **kwargs):
    raise RuntimeError("SECURITY ENFORCEMENT: dbutils.secrets.get() has been completely disabled on this compute cluster.")

# Monitor the global namespace to catch and break dbutils when Databricks injects it
class DBUtilsBlocker:
    def __init__(self):
        self.patched = False

    def __getattribute__(self, name):
        # If the user or system tries to look up dbutils
        if name == "dbutils" or (hasattr(builtins, "dbutils")):
            try:
                db = getattr(builtins, "dbutils")
                # Overwrite the get method inside the secrets class
                db.secrets.get = blocked_secrets_get
            except Exception:
                pass
        return super().__getattribute__(name)

# Inject our blocker into the system path to continuously neutralize secret calls
sys.modules[__name__].__class__.__getattribute__ = DBUtilsBlocker.__getattribute__

EOF

# Make it read-only so notebooks cannot modify it
chmod 444 "$SITE_PACKAGES/sitecustomize.py"
