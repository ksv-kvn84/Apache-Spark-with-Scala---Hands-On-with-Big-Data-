#!/bin/bash

# 1. Set your Sub ID
SUB_ID="your-subscription-id-here"
az account set --subscription "$SUB_ID"

# 2. Get your 4 Storage Account IDs
ids=$(az storage account list --query "[].id" -o tsv)

echo -e "AccountName\tDate\tUsage_GB"
echo "------------------------------------------------"

for id in $ids
do
    accountName=$(echo $id | awk -F'/' '{print $NF}')
    
    # Using --offset 30d is much safer than 'date' commands across different OS
    # We use -o json to ensure we capture the data correctly
    az monitor metrics list \
        --resource "$id" \
        --metric "UsedCapacity" \
        --namespace "Microsoft.Storage/storageAccounts" \
        --offset 30d \
        --interval "PT24H" \
        --query "value[0].timeseries[0].data[?average != null].{T:timeStamp, V:average}" \
        -o tsv | while read -r time val; do
            # Convert bytes to GB using awk
            gb=$(awk "BEGIN {printf \"%.2f\", $val/1073741824}")
            echo -e "$accountName\t$time\t$gb"
        done
done
