#!/bin/bash

# 1. Define your Subscription ID
SUB_ID="your-subscription-id-here"
az account set --subscription "$SUB_ID"

# 2. Get all storage account IDs
ids=$(az storage account list --query "[].id" -o tsv)

echo -e "AccountName\tDate\tUsage_GB"
echo "------------------------------------------------"

for id in $ids
do
    accountName=$(echo $id | awk -F'/' '{print $NF}')
    
    # We use --offset 30d to avoid the date parsing error.
    # We filter for records where average usage is not null.
    az monitor metrics list \
        --resource "$id" \
        --metric "UsedCapacity" \
        --namespace "Microsoft.Storage/storageAccounts" \
        --offset 30d \
        --interval "PT24H" \
        --query "value[0].timeseries[0].data[?average != null]" \
        -o json | jq -r ".[] | \"$accountName\t\(.timeStamp)\t\(.average)\"" | awk '{printf "%s\t%s\t%.2f\n", $1, $2, $3/1073741824}'
done
