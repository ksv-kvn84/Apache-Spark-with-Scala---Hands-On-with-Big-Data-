#!/usr/bin/env python3
"""
Manage Key Vault access policies for service accounts in an Azure AD group.
Supports dry-run mode to preview changes without applying them.
"""

import os
import sys
import json
import logging
import subprocess
import argparse
from typing import List, Dict, Tuple


# =========================
# 🔧 CONFIGURATION
# =========================
SERVICE_PREFIX = "svc_"
SECRET_PERMISSIONS = ["get", "list"]


# =========================
# 🛠️ UTILITIES
# =========================
def setup_logger() -> None:
    """Configure structured logging."""
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s | %(levelname)-8s | %(message)s",
        handlers=[logging.StreamHandler(sys.stdout)],
    )


def run_az_cli(command: List[str]) -> str:
    """Run an Azure CLI command and return stdout as string."""
    try:
        result = subprocess.run(
            ["az"] + command,
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout
    except subprocess.CalledProcessError as e:
        logging.error("Command failed: az %s", " ".join(command))
        logging.error("stderr: %s", e.stderr.strip())
        sys.exit(1)


# =========================
# 🔄 CORE FUNCTIONS
# =========================
def get_names_for_env(env: str) -> Tuple[str, str]:
    """Generate group and vault names based on environment."""
    env = env.lower()
    return f"kv-access-group-{env}", f"kv-myapp-{env}"


def get_group_members(group_name: str) -> List[Dict]:
    """Fetch members of an Azure AD group."""
    raw = run_az_cli(["ad", "group", "member", "list", "--group", group_name, "--output", "json"])
    return json.loads(raw)


def filter_service_accounts(members: List[Dict]) -> List[Dict]:
    """Filter members whose displayName starts with the service prefix."""
    return [
        {"id": m["objectId"], "name": m.get("displayName", "<no-name>")}
        for m in members if m.get("displayName", "").startswith(SERVICE_PREFIX)
    ]


def get_access_policies(vault_name: str) -> List[Dict]:
    """Fetch access policies from a Key Vault."""
    raw = run_az_cli([
        "keyvault", "show",
        "--name", vault_name,
        "--query", "properties.accessPolicies",
        "--output", "json"
    ])
    return json.loads(raw)


def has_required_permissions(policy: Dict, object_id: str) -> bool:
    """Check if a given object_id already has required permissions."""
    if policy.get("objectId") != object_id:
        return False

    perms = policy.get("permissions", {}).get("secrets", [])
    return all(p in perms for p in SECRET_PERMISSIONS)


def assign_access(vault_name: str, object_id: str, name: str, dry_run: bool = False) -> None:
    """Assign get/list secret access to a member."""
    if dry_run:
        logging.info("[DRY-RUN] Would assign secret access to: %s (%s)", name, object_id)
        return

    logging.info("Assigning secret access to: %s (%s)", name, object_id)
    try:
        subprocess.run(
            [
                "az", "keyvault", "set-policy",
                "--name", vault_name,
                "--object-id", object_id,
                "--secret-permissions", *SECRET_PERMISSIONS
            ],
            check=True,
        )
    except subprocess.CalledProcessError as e:
        logging.error("Failed to assign policy to %s (%s)", name, object_id)
        logging.error("stderr: %s", e.stderr.strip())


# =========================
# 🚀 MAIN
# =========================
def main():
    setup_logger()

    parser = argparse.ArgumentParser(description="Manage Key Vault access policies for service accounts.")
    parser.add_argument("--dry-run", action="store_true", help="Preview changes without applying them")
    args = parser.parse_args()

    env = os.environ.get("ENVIRONMENT")
    if not env:
        logging.error("ENVIRONMENT variable not set.")
        sys.exit(1)

    group_name, vault_name = get_names_for_env(env)
    logging.info("Environment: %s", env)
    logging.info("Group Name: %s", group_name)
    logging.info("Key Vault Name: %s", vault_name)

    members = get_group_members(group_name)
    svc_members = filter_service_accounts(members)
    logging.info("Found %d service account(s).", len(svc_members))

    access_policies = get_access_policies(vault_name)

    for member in svc_members:
        object_id, name = member["id"], member["name"]

        if any(has_required_permissions(p, object_id) for p in access_policies):
            logging.info("✔ %s already has secret permissions. Skipping.", name)
            continue

        assign_access(vault_name, object_id, name, dry_run=args.dry_run)

    if args.dry_run:
        logging.info("✅ Dry run complete. No changes applied.")
    else:
        logging.info("✅ All done.")


if __name__ == "__main__":
    main()
